class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int m = matrix.length;
        int n = matrix[0].length;

        int[] arr = new int[m*n];
        int index = 0;

        for(int i =0;i<m;i++){
            for(int j=0;j<n;j++){
                arr[index++]=matrix[i][j];
            }
        }

        int low = 0;
        int high = arr.length-1;

        while(low<=high){
            
            int mid = low + (high-low)/2;

            if(arr[mid]==target){
                return true;
            }
            else if(arr[mid]<target){
                low = mid+1;
            }
            else{
                high = mid-1;
            }
        }

        return false;
        
    }
}
